# LLM provider. Everything runs without any of these — the wrapper falls back to
# a deterministic mock so the whole system works with zero API keys.
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Which backend to use: anthropic | groq | mock | auto (default: auto)
LLM_PROVIDER=auto
LLM_MODEL=

# External data adapters. Unset => that adapter serves realistic mock data.
OPENWEATHER_API_KEY=
GOOGLE_PLACES_API_KEY=

# Optional tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=letsgo
