# Copy this file to .env and fill in what you have.
#
#   cp .env.example .env
#
# Nothing here is required. Every key is optional: the model wrapper falls
# back to deterministic mock responses and every data adapter falls back to
# realistic mock data, so the whole system runs end to end on an empty file.
# .env is gitignored; this template must stay blank.


# ---------------------------------------------------------------------------
# Model — the one that actually matters
# ---------------------------------------------------------------------------

# https://console.anthropic.com/settings/keys  (card required, usage is cents)
# The project targets claude-sonnet-5.
ANTHROPIC_API_KEY=

# https://console.groq.com/keys  (free, no card) — cheap fallback for iteration
GROQ_API_KEY=

# anthropic | groq | mock | auto
# auto: Anthropic if its key is set, else Groq, else mock.
LLM_PROVIDER=auto

# Blank uses the default model for the chosen provider.
LLM_MODEL=


# ---------------------------------------------------------------------------
# Data adapters — each one serves mock data when its key is missing
# ---------------------------------------------------------------------------

# Weather. https://home.openweathermap.org/api_keys  (free, no card)
# Takes a couple of hours to activate after signup; 401s until then are normal.
OPENWEATHER_API_KEY=

# Attractions. https://opentripmap.io/product  (free, no card)
# Chosen over Google Places, which requires a billing card even on its free
# tier. Grounds the plan in real places instead of trusting the model.
OPENTRIPMAP_API_KEY=

# Wikivoyage and Overpass need no key and are used without configuration.
# Google Places is supported as an alternative if you would rather use it:
# GOOGLE_PLACES_API_KEY=

# Flights and accommodation are mocked by design — the real APIs are gated
# behind business accounts. Those adapters are labelled as mock in the output.


# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# SQLite by default. Point at Postgres when you want it:
#   postgresql+psycopg://user:pass@localhost:5432/letsgo
DATABASE_URL=sqlite:///./letsgo.db


# ---------------------------------------------------------------------------
# Tracing (optional)
# ---------------------------------------------------------------------------

# https://smith.langchain.com -> Settings -> API Keys  (free, no card)
# Set LANGSMITH_TRACING=true once the key is in place.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=letsgo
